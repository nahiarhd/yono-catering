generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  yono
  member
}

model User {
  id               String           @id @default(cuid())
  name             String           @unique
  pinHash          String
  role             Role
  pushSubscription Json?
  createdAt        DateTime         @default(now())
  responses        Response[]
  dishPreferences  DishPreference[]
}

model Menu {
  id             String     @id @default(cuid())
  date           DateTime   @db.Date
  dish           String
  note           String?
  cutoffOverride String?
  createdAt      DateTime   @default(now())
  responses      Response[]

  @@unique([date])
}

model Response {
  id        String   @id @default(cuid())
  menuId    String
  userId    String
  wants     Boolean
  swapDish  String?
  note      String?
  updatedAt DateTime @updatedAt
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([menuId, userId])
}

model Settings {
  id             String @id @default("singleton")
  standingCutoff String @default("08:00")
  reminderTime   String @default("07:00")
  defaultDishes  Json   @default("[]")
}

model DishPreference {
  id       String  @id @default(cuid())
  userId   String
  forDish  String
  wants    Boolean
  swapDish String?
  note     String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, forDish])
}