generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  yono
  admin
  member
}

model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id               String           @id @default(cuid())
  name             String           @unique
  pinHash          String
  role             Role
  telegramChatId   String?
  // Set when the last Telegram send/check to this chat failed (bot blocked or never started)
  telegramFailedAt DateTime?
  // false = away (cuti/luar kota): no reminders, not counted as pending
  active           Boolean          @default(true)
  groupId          String?
  group            Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  responses        Response[]
  dishPreferences  DishPreference[]
  announcements    Announcement[]
}


model Menu {
  id             String     @id @default(cuid())
  date           DateTime
  // "" = belum diberi nama warung; satu hari bisa punya beberapa warung
  vendor         String     @default("")
  dish           String
  subDishes      String?
  addOns         String?
  // [{ name, variants, addOns }] per dish; null on menus posted before per-dish options
  dishOptions    Json?
  note           String?
  cutoffOverride String?
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  responses      Response[]

  @@unique([date, vendor])
}

model Response {
  id        String   @id @default(cuid())
  menuId    String
  userId    String
  wants     Boolean
  swapDish  String?
  addOns    String?
  note      String?
  updatedAt DateTime @updatedAt
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([menuId, userId])
}

model Settings {
  id             String @id @default("singleton")
  standingCutoff String @default("08:00")
  reminderTime   String @default("07:00")
  defaultDishes  Json   @default("[]")
}

model DishPreference {
  id       String  @id @default(cuid())
  userId   String
  forDish  String
  wants    Boolean
  swapDish String?
  addOns   String?
  note     String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, forDish])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String?
  message     String
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}