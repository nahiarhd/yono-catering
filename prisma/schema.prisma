generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  yono
  admin
  member
}

model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id               String           @id @default(cuid())
  name             String           @unique
  pinHash          String
  role             Role
  telegramChatId   String?
  groupId          String?
  group            Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  responses        Response[]
  dishPreferences  DishPreference[]
}


model Menu {
  id             String     @id @default(cuid())
  date           DateTime
  dish           String
  subDishes      String?
  addOns         String?
  note           String?
  cutoffOverride String?
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  responses      Response[]

  @@unique([date])
}

model Response {
  id        String   @id @default(cuid())
  menuId    String
  userId    String
  wants     Boolean
  swapDish  String?
  addOns    String?
  note      String?
  updatedAt DateTime @updatedAt
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([menuId, userId])
}

model Settings {
  id             String @id @default("singleton")
  standingCutoff String @default("08:00")
  reminderTime   String @default("07:00")
  defaultDishes  Json   @default("[]")
}

model DishPreference {
  id       String  @id @default(cuid())
  userId   String
  forDish  String
  wants    Boolean
  swapDish String?
  addOns   String?
  note     String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, forDish])
}